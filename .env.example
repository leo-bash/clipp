NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=4000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=http://localhost:3000
AUTH_MODE=disabled
# Required when AUTH_MODE=api-key; never commit real values.
ADMIN_API_KEY=
EDITOR_API_KEY=
VIEWER_API_KEY=

# Use postgres/redis in Docker or when local services are available.
# memory/mock make the API and workers runnable without external services.
DATABASE_MODE=memory
DATABASE_URL=postgresql://shortfactory:shortfactory@localhost:5432/shortfactory
QUEUE_MODE=mock
REDIS_URL=redis://localhost:6379

MONTHLY_BUDGET_EUR=50
APP_ENCRYPTION_KEY=replace-with-a-32-byte-runtime-secret

# Provider credentials are intentionally empty in local development.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
STORAGE_ROOT=./.data/storage
STOP_ALL_PUBLISHING=false
STOP_RENDERING=false
STOP_PAID_APIS=false
RENDER_CONCURRENCY=1
AI_CONCURRENCY=3
PUBLISH_CONCURRENCY=1
ANALYTICS_CONCURRENCY=2
LLM_PROVIDER=mock
LLM_API_KEY=
TTS_PROVIDER=disabled
TTS_API_KEY=
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_MODE=UPLOAD_DRAFT
TIKTOK_FALLBACK_TO_DRAFT=true
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
