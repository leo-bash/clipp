NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=4000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=http://localhost:3000,https://clipp-odrass-projects.vercel.app
DASHBOARD_URL=http://localhost:3000
# Authentication is disabled by default for the local dashboard.
AUTH_MODE=disabled
# Optional: set AUTH_MODE=password and generate this value with: pnpm auth:hash
AUTH_PASSWORD_HASH=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=shortfactory_session
AUTH_COOKIE_SECURE=false
AUTH_AUDIT_LOG_PATH=./.data/auth-audit.jsonl
# Required when AUTH_MODE=api-key; never commit real values.
ADMIN_API_KEY=
EDITOR_API_KEY=
VIEWER_API_KEY=

# Use postgres/redis in Docker or when local services are available.
# memory/mock make the API and workers runnable without external services.
DATABASE_MODE=memory
DATABASE_URL=postgresql://shortfactory:shortfactory@localhost:5432/shortfactory
QUEUE_MODE=mock
REDIS_URL=redis://localhost:6379

MONTHLY_BUDGET_EUR=50
APP_ENCRYPTION_KEY=replace-with-a-32-byte-runtime-secret

# Provider credentials are intentionally empty in local development.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
STORAGE_ROOT=./.data/storage
STOP_ALL_PUBLISHING=false
STOP_RENDERING=false
STOP_PAID_APIS=false
RENDER_CONCURRENCY=1
AI_CONCURRENCY=3
PUBLISH_CONCURRENCY=1
ANALYTICS_CONCURRENCY=2
LLM_PROVIDER=mock
LLM_API_KEY=
TTS_PROVIDER=disabled
TTS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL_ID=eleven_multilingual_v2
TTS_OUTPUT_FORMAT=mp3_44100_128
VOICE_SPEED=1.5
TTS_OUTPUT_ROOT=./.data/tts
TTS_COST_PER_1000_CHARS_EUR=0.30
TTS_DEFAULT_PERSPECTIVE=auto
TTS_VOICE_IDS_MALE=
TTS_VOICE_ID_MALE=
TTS_VOICE_ID_FEMALE=
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=

# Local video pipeline. Use 4K Video Downloader+ to save licensed/authorized
# source videos here, then run `pnpm pipeline:local`.
LOCAL_SOURCE_DIR=/Users/your-user/Movies/4K Video Downloader+
AUTO_DELETE_EXHAUSTED_SOURCE=true
AUTO_DELETE_UPLOADED_VIDEO=true
SUBTITLE_PROVIDER=whisper-local
SUBTITLE_FPS=60
WHISPER_PYTHON=./.data/whisper-venv/bin/python
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional legacy provider:
CAPTIONFORGE_URL=http://127.0.0.1:8420
CAPTIONFORGE_BINARY=./.data/captionforge-venv312/bin/captionforge
CAPTIONFORGE_MODEL=base
SCRIPT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google AI Pro for the Gemini app is separate from Gemini API billing/quota.
# For more than the free API quota, enable billing for the API project in AI Studio.
GEMINI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Public Reddit feed settings. The source post is only an editorial reference;
# the generated script must be an original adaptation and always needs review.
REDDIT_USER_AGENT=shortfactory-reddit-pilot/0.1 (local editorial tool)
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_OAUTH_BASE_URL=https://oauth.reddit.com
REDDIT_BASE_URL=https://www.reddit.com
REDDIT_FETCH_LIMIT=25
REDDIT_MIN_SCORE=10
REDDIT_MAX_SOURCE_CHARACTERS=14000
REDDIT_ALLOW_NSFW=false
REDDIT_SUBREDDITS=
REDDIT_USAGE_FILE=./.data/local-pipeline/reddit-usage.jsonl
REDDIT_INTRO_DURATION=2.5
POSTFULLY_PROVIDER=postfully-browser
POSTFULLY_URL=https://postfully.app/tools/reddit-post-template/
POSTFULLY_USERNAME=ScrollTales
POSTFULLY_TIMEOUT_MS=45000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/youtube/callback
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/tiktok/callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_MODE=UPLOAD_DRAFT
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
TIKTOK_FALLBACK_TO_DRAFT=true
PLATFORM_CREDENTIALS_FILE=../../.data/platform-credentials.json
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
