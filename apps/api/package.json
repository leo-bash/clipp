{
  "name": "@shortfactory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --out-dir dist --sourcemap",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@shortfactory/config": "workspace:*",
    "@shortfactory/cost-control": "workspace:*",
    "@shortfactory/database": "workspace:*",
    "@shortfactory/logger": "workspace:*",
    "@shortfactory/queue": "workspace:*",
    "@shortfactory/rights": "workspace:*",
    "@shortfactory/shared": "workspace:*",
    "fastify": "^5.5.0"
    ,"zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.35.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
